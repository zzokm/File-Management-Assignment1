# ====================================================================
# Git Ignore - Healthcare Management System (IS321)
# ====================================================================

# Local archive
archive/

# Build outputs & directories
build/
bin/
out/
target/

# CMake cache and generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeScripts/
Makefile
*.ninja
.ninja_*
compile_commands.json
CTestTestfile.cmake

# Compiled binaries, objects, and libraries
*.exe
*.obj
*.o
*.lib
*.a
*.dll
*.so
*.dylib

# Debug symbols & linker artifacts
*.pdb
*.idb
*.ilk
*.exp
*.map

# Runtime data & binary database files
data/
*.bin
*.dat
*.db

# Compressed archives & submission packages
*.zip
*.tar
*.tar.gz
*.7z

# Visual Studio / IDE configurations
.vs/
.vscode/
.idea/
cmake-build-*/
*.sln
*.vcxproj
*.vcxproj.*
*.suo
*.user

# Operating System files
Thumbs.db
[Dd]esktop.ini
.DS_Store

# Temporary & log files
*.log
*.tmp
